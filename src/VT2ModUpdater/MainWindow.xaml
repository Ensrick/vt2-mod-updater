<Window x:Class="VT2ModUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VT2ModUpdater.ViewModels"
        Title="VT2 Mod Updater"
        Height="730" Width="1050"
        Background="#1B1B1F"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A6EA5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#333339"/>
                    <Setter Property="Foreground" Value="#777"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEE"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="VT2 Mod Updater" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="{Binding ReleaseTagDisplay}" Margin="16,0,0,0" Opacity="0.6"/>
        </StackPanel>

        <!-- status bar -->
        <Border Grid.Row="1" Background="#26262C" Padding="12,8" CornerRadius="4" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="{Binding WorkshopPathDisplay}" Opacity="0.8" DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding StatusMessage}" DockPanel.Dock="Right" HorizontalAlignment="Right" Opacity="0.8"/>
            </DockPanel>
        </Border>

        <!-- mod table -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Mods}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  Background="#1B1B1F"
                  Foreground="#EEE"
                  RowBackground="#202028"
                  AlternatingRowBackground="#26262C"
                  BorderThickness="0"
                  IsReadOnly="True"
                  IsEnabled="{Binding CanEditSourceExactRecovery}"
                  SelectedItem="{Binding SelectedMod, Mode=TwoWay}">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2E2E36"/>
                    <Setter Property="Foreground" Value="#EEE"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#EEE"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="8,6"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mod" Binding="{Binding FriendlyName}" Width="220"/>
                <DataGridTextColumn Header="Installed" Binding="{Binding InstalledVersion}" Width="160"/>
                <DataGridTextColumn Header="Latest" Binding="{Binding LatestVersion}" Width="160"/>
                <DataGridTextColumn Header="State" Binding="{Binding StateLabel}" Width="*"/>
                <DataGridTemplateColumn Header="" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Update"
                                    Command="{Binding DataContext.UpdateOneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanUpdate}"
                                    Margin="0,2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- explicit, opt-in source-exact recovery -->
        <Border Grid.Row="3"
                Background="#26262C"
                Padding="12,10"
                CornerRadius="4"
                Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Source-exact recovery (advanced)"
                           FontWeight="SemiBold"
                           FontSize="14"/>
                <TextBlock Margin="0,3,0,8"
                           Opacity="0.72"
                           TextWrapping="Wrap"
                           Text="Explicitly restore one selected mod from an exact historical source commit. This replaces only its synthetic 10&lt;Workshop ID&gt; folder; it does not change how Update or Update All select the latest release."/>
                <Grid IsEnabled="{Binding CanEditSourceExactRecovery}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding SourceExactSelectionDisplay}"
                               Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SourceExactCommitInput, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Exactly 40 lowercase hexadecimal characters"
                             Background="#17171B"
                             Foreground="#EEE"
                             BorderBrush="#555560"
                             Padding="8,5"
                             Margin="0,0,10,0"/>
                    <Button Grid.Column="2"
                            Content="Recover Exact Source"
                            Command="{Binding RecoverExactSourceCommand}"
                            Padding="14,6"/>
                </Grid>
                <DockPanel Margin="0,8,0,0">
                    <Button Content="Cancel Recovery"
                            Command="{Binding CancelExactSourceRecoveryCommand}"
                            DockPanel.Dock="Right"
                            Background="#704040"
                            Margin="12,0,0,0"
                            Padding="12,5"/>
                    <TextBlock Text="{Binding SourceExactRecoveryMessage}"
                               TextWrapping="Wrap"
                               Opacity="0.82"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- bottom buttons -->
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <Button Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    DockPanel.Dock="Left"
                    Padding="16,8"
                    Background="#444"
                    Margin="0,0,8,0"/>
            <Button Content="Open Workshop Folder"
                    Command="{Binding OpenWorkshopFolderCommand}"
                    DockPanel.Dock="Left"
                    Padding="16,8"
                    Background="#444"
                    Margin="0,0,8,0"/>
            <Button Content="Verify Installed Bundles"
                    Command="{Binding VerifyInstalledCommand}"
                    DockPanel.Dock="Left"
                    Padding="16,8"
                    Background="#444"
                    ToolTip="Detect tampering of already-installed bundles. Compares the stash from install time against current on-disk contents and the latest manifest."/>
            <Button Content="Update All Out-of-Date"
                    Command="{Binding UpdateAllCommand}"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Padding="20,8"
                    FontWeight="Bold"/>
        </DockPanel>
    </Grid>
</Window>
